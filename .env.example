# Copy to .env and adjust. These defaults are for the local Docker stack only.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_USER=radar
WAREHOUSE_PASSWORD=radar
WAREHOUSE_DB=radar

# Local Metabase admin, created by `python -m dashboard.setup_metabase`
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@radar.local
METABASE_ADMIN_PASSWORD=change-me-to-a-long-random-password
