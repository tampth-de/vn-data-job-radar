{
    // Ready-made run configurations: open "Run and Debug" (Ctrl+Shift+D), pick one, press F5.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Refresh everything (pull, load, dbt, dashboard)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/refresh.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            // Writes to data_local/ so it never touches data/ (the clone of the data repo)
            "name": "Test scrape TopDev (into data_local/)",
            "type": "debugpy",
            "request": "launch",
            "module": "ingestion.topdev.fetch_jobs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8", "RADAR_RAW_ROOT": "data_local/raw" }
        },
        {
            // Writes to data_local/ so it never touches data/ (the clone of the data repo)
            "name": "Test scrape CareerLink (into data_local/)",
            "type": "debugpy",
            "request": "launch",
            "module": "ingestion.careerlink.fetch_jobs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8", "RADAR_RAW_ROOT": "data_local/raw" }
        },
        {
            "name": "Load raw data into warehouse",
            "type": "debugpy",
            "request": "launch",
            "module": "load.all",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Rebuild Metabase dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/refresh.py",
            "args": ["--rebuild-dashboard"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Run current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONPATH": "${workspaceFolder}", "PYTHONIOENCODING": "utf-8" }
        }
    ]
}
