{
    // Ready-made run configurations: open "Run and Debug" (Ctrl+Shift+D), pick one, press F5.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Refresh everything (pull, load, dbt, dashboard)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/refresh.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Scrape TopDev (today)",
            "type": "debugpy",
            "request": "launch",
            "module": "ingestion.topdev.fetch_jobs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Load raw data into warehouse",
            "type": "debugpy",
            "request": "launch",
            "module": "load.topdev",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Rebuild Metabase dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/refresh.py",
            "args": ["--rebuild-dashboard"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Run current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "PYTHONPATH": "${workspaceFolder}", "PYTHONIOENCODING": "utf-8" }
        }
    ]
}
